{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Employee",
  "type": "object",
  "required": ["id", "firstName", "lastName", "gender", "email", "phone", "dateOfBirth", "hireDate", "jobId", "departmentId",
               "managerId", "countryCode", "regionId", "salary", "status", "terminationDate", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "firstName": { "type": "string", "minLength": 1, "maxLength": 50 },
    "lastName": { "type": "string", "minLength": 1, "maxLength": 50 },
    "gender": { "enum": ["MALE", "FEMALE"] },
    "email": { "type": "string", "pattern": "^[^A-Z\\s@]+@[^A-Z\\s@]+\\.[^A-Z\\s@]+$" },
    "phone": { "type": ["string", "null"], "pattern": "^\\d{3}-\\d{3}-\\d{4}$" },
    "dateOfBirth": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "hireDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "jobId": { "type": "integer" },
    "departmentId": { "type": "integer" },
    "managerId": { "type": ["integer", "null"] },
    "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "regionId": { "type": "integer", "minimum": 1, "maximum": 20 },
    "salary": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["ACTIVE", "TERMINATED"] },
    "terminationDate": { "type": ["string", "null"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": false
}
