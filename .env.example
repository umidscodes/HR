# Optional settings. The defaults work out of the box; set these in your terminal before npm run dev.
#   Command Prompt:  set PORT=8081
#   PowerShell:      $env:PORT="8081"
#   macOS/Linux:     PORT=8081 npm run dev
#
# PORT=8080            the app, Swagger UI and API
# DB_PORT=5434         the embedded PostgreSQL database
# DATABASE_URL=postgres://postgres:postgres@localhost:5434/icehr   use your own PostgreSQL instead of the embedded one
# ICEHR_QUIET_LOGS=true   stop printing one line per API call
